class Solution {
    public long splitArray(int[] n) {
        long a = 0, b = 0;
        for (int i = 0; i < n.length; i++) {
            if (p(i)) a += n[i];
            else b += n[i];
        }
        return Math.abs(a - b);
    }

    private boolean p(int x) {
        if (x < 2) return false;
        for (int i = 2; i * i <= x; i++) {
            if (x % i == 0) return false;
        }
        return true;
    }
}
